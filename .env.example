# =============================================================================
# Intelligent Knowledge Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Azure OpenAI Configuration ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBED=text-embedding-3-small
LLM_TEMPERATURE=0.0

# --- Embedding Configuration ---
# Options: "azure_openai" or "huggingface"
# azure_openai: uses the deployment specified in AZURE_OPENAI_DEPLOYMENT_EMBED
# huggingface: "all-MiniLM-L6-v2" (384d) — free, no API key needed
EMBEDDING_PROVIDER=azure_openai

# --- Document Parser ---
# Primary: "azure_di" (Azure Document Intelligence — structured markdown, tables, images)
# Fallback: "pypdf" (raw text extraction, no structure awareness)
# If azure_di is selected but credentials are missing, falls back to pypdf automatically.
PARSER_BACKEND=azure_di
DOCUMENTINTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
DOCUMENTINTELLIGENCE_API_KEY=your-azure-di-key-here
DOCUMENTINTELLIGENCE_MODEL=prebuilt-layout
# Set to "true" to extract figures and summarize with GPT-4o vision
IMAGE_SUMMARY_ENABLED=true

# --- ChromaDB Configuration ---
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=knowledge_base

# --- Retrieval Configuration ---
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Retrieval mode: "dense" (vector only) or "hybrid" (BM25 + dense with Reciprocal Rank Fusion)
RETRIEVAL_MODE=hybrid
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# Cross-encoder re-ranking: re-scores top results with a more accurate model
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# --- Corpus ---
CORPUS_DIR=./corpus

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Observability (optional) ---
# Set to "true" to enable LangSmith tracing (requires LANGCHAIN_API_KEY)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=knowledge-assistant

# --- Logging ---
LOG_LEVEL=INFO
